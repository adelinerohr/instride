# The NEW Neon database (not the Encore one). Same value as packages/db/.env
DATABASE_URL=postgres://user:password@host/instride?sslmode=require

# Any long random string (openssl rand -base64 32). Password hashes don't
# depend on it, so migrated users can still log in.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://127.0.0.1:4000

PORT=4000
NODE_ENV=development
